<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Nombre neutro del ejecutable (es el nombre del proceso en los registros).
         Cámbialo por lo que quieras; el namespace interno sigue siendo Mirror. -->
    <AssemblyName>LocalPanel</AssemblyName>
    <RootNamespace>Mirror</RootNamespace>
    <!-- No requiere permisos de administrador -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <!-- Permite compilar el proyecto Windows desde Linux/CI (el .exe se ejecuta en Windows) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Argon2id para derivar/verificar la contraseña -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

</Project>
