# OpenSSH configurado exclusivamente como servidor SFTP
Port 22
AddressFamily inet
HostKey /etc/ssh/claves_host/ssh_host_ed25519_key
HostKey /etc/ssh/claves_host/ssh_host_rsa_key

# Autenticación: solo claves públicas, nunca root ni contraseñas
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
AuthorizedKeysFile /etc/ssh/authorized_keys/%u
MaxAuthTries 3
LoginGraceTime 30
MaxStartups 10:30:60

# Sin túneles ni reenvíos
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no

LogLevel VERBOSE
Subsystem sftp internal-sftp -l INFO

AllowGroups sftpusuarios
Match Group sftpusuarios
    ChrootDirectory %h
    ForceCommand internal-sftp -l INFO
